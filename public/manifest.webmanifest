{
  "name": "DicomLens — DICOM Viewer",
  "short_name": "DicomLens",
  "description": "View DICOM images in the browser. Files stay on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#020617",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/dicom": [".dcm", ".dicom"],
        "application/zip": [".zip"]
      }
    }
  ]
}
